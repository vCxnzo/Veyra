import React, { useState } from 'react';
import {
  ArrowRight,
  Building2,
  CheckCircle2,
  Crown,
  Hash,
  Loader2,
  LogIn,
  Search,
  ShieldCheck,
  Users,
} from 'lucide-react';

const API_URL = 'https://api.veyra.one';

interface ConnectedCommunity {
  id: string;
  groupId: string;
  groupName: string;
  groupDescription: string;
  memberCount: number;
  ownerName: string | null;
  ownerId: string | null;
  iconUrl: string | null;
  inviteCode?: string;
}

interface AddGroupPageProps {
  onCommunityConnected: (
    community: ConnectedCommunity
  ) => void;

  onToast: (
    title: string,
    message?: string,
    type?: 'success' | 'error' | 'info'
  ) => void;

  onLogout?: () => void;
}

type SetupMode =
  | 'create'
  | 'join';

export const AddGroupPage: React.FC<
  AddGroupPageProps
> = ({
  onCommunityConnected,
  onToast,
  onLogout,
}) => {
  const [
    setupMode,
    setSetupMode,
  ] = useState<SetupMode>('create');

  const [
    groupId,
    setGroupId,
  ] = useState('');

  const [
    inviteCode,
    setInviteCode,
  ] = useState('');

  const [
    loading,
    setLoading,
  ] = useState(false);

  const handleConnectCommunity = async (
    event: React.FormEvent
  ) => {
    event.preventDefault();

    const cleanedGroupId =
      groupId.trim();

    if (!cleanedGroupId) {
      onToast(
        'Group ID Required',
        'Enter the numeric ID of your Roblox community.',
        'error'
      );

      return;
    }

    if (!/^\d+$/.test(cleanedGroupId)) {
      onToast(
        'Invalid Group ID',
        'The Roblox Group ID can only contain numbers.',
        'error'
      );

      return;
    }

    setLoading(true);

    try {
      const response =
        await fetch(
          `${API_URL}/api/communities`,
          {
            method: 'POST',

            credentials: 'include',

            headers: {
              'Content-Type':
                'application/json',

              Accept:
                'application/json',
            },

            body:
              JSON.stringify({
                groupId:
                  cleanedGroupId,
              }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            'The community could not be connected.'
        );
      }

      onToast(
        'Community Connected',
        `${data.community.groupName} has been added to your Veyra account.`,
        'success'
      );

      onCommunityConnected(
        data.community
      );
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : 'Something went wrong while connecting your community.';

      onToast(
        'Connection Failed',
        message,
        'error'
      );
    } finally {
      setLoading(false);
    }
  };

  const handleJoinCommunity = async (
    event: React.FormEvent
  ) => {
    event.preventDefault();

    const cleanedCode =
      inviteCode
        .trim()
        .toUpperCase();

    if (!cleanedCode) {
      onToast(
        'Invite Code Required',
        'Enter the invite code provided by the community owner.',
        'error'
      );

      return;
    }

    if (cleanedCode.length < 4) {
      onToast(
        'Invalid Invite Code',
        'That community invite code is too short.',
        'error'
      );

      return;
    }

    setLoading(true);

    try {
      const response =
        await fetch(
          `${API_URL}/api/communities/join`,
          {
            method: 'POST',

            credentials: 'include',

            headers: {
              'Content-Type':
                'application/json',

              Accept:
                'application/json',
            },

            body:
              JSON.stringify({
                inviteCode:
                  cleanedCode,
              }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.message ||
            'That community could not be joined.'
        );
      }

      onToast(
        'Community Joined',
        `You now have access to ${data.community.groupName}.`,
        'success'
      );

      onCommunityConnected(
        data.community
      );
    } catch (error) {
      const message =
        error instanceof Error
          ? error.message
          : 'Something went wrong while joining the community.';

      onToast(
        'Unable to Join',
        message,
        'error'
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-white flex">

      {/* Left Side */}

      <div className="hidden lg:flex lg:w-[42%] border-r border-slate-800 relative overflow-hidden">

        <div className="absolute inset-0 bg-gradient-to-br from-indigo-600/20 via-transparent to-purple-600/10" />

        <div className="absolute top-20 left-20 w-72 h-72 bg-indigo-500/10 rounded-full blur-3xl" />

        <div className="absolute bottom-20 right-10 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl" />

        <div className="relative z-10 flex flex-col justify-between w-full p-12">

          <div className="flex items-center gap-3">

            <div className="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center font-black text-lg shadow-lg shadow-indigo-600/20">
              V
            </div>

            <div>
              <p className="font-bold text-xl tracking-tight">
                Veyra
              </p>

              <p className="text-[10px] text-slate-500 uppercase tracking-[0.2em]">
                Community Management
              </p>
            </div>

          </div>

          <div>

            <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-medium mb-6">

              <ShieldCheck className="w-3.5 h-3.5" />

              Secure community access

            </div>

            <h1 className="text-4xl font-bold leading-tight max-w-md">
              Start managing your community with Veyra.
            </h1>

            <p className="text-slate-400 mt-5 max-w-md leading-relaxed">
              Connect a Roblox community that you manage, or join an existing Veyra workspace through an invite code.
            </p>

            <div className="mt-10 space-y-5">

              <Feature
                icon={
                  <Crown className="w-4 h-4" />
                }
                title="Community owners"
                description="Connect your Roblox group and create a new management workspace."
              />

              <Feature
                icon={
                  <Users className="w-4 h-4" />
                }
                title="Staff members"
                description="Join a workspace using a secure invite code from your leadership team."
              />

              <Feature
                icon={
                  <CheckCircle2 className="w-4 h-4" />
                }
                title="One shared dashboard"
                description="Manage shifts, staff activity, moderation, applications, and quotas."
              />

            </div>

          </div>

          <p className="text-xs text-slate-600">
            Veyra Community Management
          </p>

        </div>

      </div>

      {/* Right Side */}

      <div className="flex-1 flex items-center justify-center px-6 py-12">

        <div className="w-full max-w-lg">

          <div className="lg:hidden flex items-center gap-3 mb-10">

            <div className="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center font-black">
              V
            </div>

            <span className="font-bold text-xl">
              Veyra
            </span>

          </div>

          <div className="mb-8">

            <p className="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-400 mb-3">
              Community Setup
            </p>

            <h2 className="text-3xl font-bold tracking-tight">
              Choose how to continue
            </h2>

            <p className="text-sm text-slate-400 mt-3 leading-relaxed">
              Add a community you manage or join an existing workspace.
            </p>

          </div>

          {/* Mode Selector */}

          <div className="grid grid-cols-2 gap-3 mb-7">

            <button
              type="button"
              onClick={() =>
                setSetupMode('create')
              }
              disabled={loading}
              className={`rounded-2xl border p-4 text-left transition-all ${
                setupMode === 'create'
                  ? 'bg-indigo-500/10 border-indigo-500 ring-1 ring-indigo-500/30'
                  : 'bg-slate-900/60 border-slate-800 hover:border-slate-700'
              }`}
            >

              <div
                className={`w-9 h-9 rounded-lg flex items-center justify-center mb-3 ${
                  setupMode === 'create'
                    ? 'bg-indigo-600 text-white'
                    : 'bg-slate-800 text-slate-400'
                }`}
              >
                <Building2 className="w-4 h-4" />
              </div>

              <p className="text-sm font-semibold text-white">
                Add Your Community
              </p>

              <p className="text-[11px] text-slate-400 mt-1 leading-relaxed">
                Create a Veyra workspace for your Roblox group.
              </p>

            </button>

            <button
              type="button"
              onClick={() =>
                setSetupMode('join')
              }
              disabled={loading}
              className={`rounded-2xl border p-4 text-left transition-all ${
                setupMode === 'join'
                  ? 'bg-indigo-500/10 border-indigo-500 ring-1 ring-indigo-500/30'
                  : 'bg-slate-900/60 border-slate-800 hover:border-slate-700'
              }`}
            >

              <div
                className={`w-9 h-9 rounded-lg flex items-center justify-center mb-3 ${
                  setupMode === 'join'
                    ? 'bg-indigo-600 text-white'
                    : 'bg-slate-800 text-slate-400'
                }`}
              >
                <LogIn className="w-4 h-4" />
              </div>

              <p className="text-sm font-semibold text-white">
                Join Community
              </p>

              <p className="text-[11px] text-slate-400 mt-1 leading-relaxed">
                Enter an invite code from a community owner.
              </p>

            </button>

          </div>

          {/* Add Community Form */}

          {setupMode === 'create' && (

            <form
              onSubmit={
                handleConnectCommunity
              }
              className="rounded-2xl bg-slate-900/70 border border-slate-800 p-6"
            >

              <div className="flex items-start gap-3 mb-6">

                <div className="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
                  <Crown className="w-5 h-5" />
                </div>

                <div>

                  <h3 className="text-sm font-semibold text-white">
                    Create your workspace
                  </h3>

                  <p className="text-xs text-slate-400 mt-1 leading-relaxed">
                    Enter the numeric ID from your Roblox community URL.
                  </p>

                </div>

              </div>

              <label className="block text-xs font-semibold text-slate-300 mb-2">
                Roblox Group ID
              </label>

              <div className="relative">

                <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" />

                <input
                  type="text"
                  value={groupId}
                  onChange={(event) =>
                    setGroupId(
                      event.target.value
                    )
                  }
                  placeholder="Example: 2618056"
                  inputMode="numeric"
                  disabled={loading}
                  className="w-full h-12 rounded-xl bg-slate-950 border border-slate-800 pl-10 pr-4 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 disabled:opacity-60"
                />

              </div>

              <p className="text-[11px] text-slate-500 mt-2">
                Example URL: roblox.com/communities/2618056
              </p>

              <button
                type="submit"
                disabled={loading}
                className="w-full h-12 mt-5 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:bg-indigo-600/50 disabled:cursor-not-allowed text-white text-sm font-semibold transition-colors flex items-center justify-center gap-2"
              >

                {loading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    Connecting...
                  </>
                ) : (
                  <>
                    Add Community
                    <ArrowRight className="w-4 h-4" />
                  </>
                )}

              </button>

            </form>

          )}

          {/* Join Community Form */}

          {setupMode === 'join' && (

            <form
              onSubmit={
                handleJoinCommunity
              }
              className="rounded-2xl bg-slate-900/70 border border-slate-800 p-6"
            >

              <div className="flex items-start gap-3 mb-6">

                <div className="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
                  <Users className="w-5 h-5" />
                </div>

                <div>

                  <h3 className="text-sm font-semibold text-white">
                    Join an existing workspace
                  </h3>

                  <p className="text-xs text-slate-400 mt-1 leading-relaxed">
                    Ask a community owner or administrator for their Veyra invite code.
                  </p>

                </div>

              </div>

              <label className="block text-xs font-semibold text-slate-300 mb-2">
                Community Invite Code
              </label>

              <div className="relative">

                <Hash className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" />

                <input
                  type="text"
                  value={inviteCode}
                  onChange={(event) =>
                    setInviteCode(
                      event.target.value
                        .toUpperCase()
                        .replace(
                          /[^A-Z0-9-]/g,
                          ''
                        )
                    )
                  }
                  placeholder="Example: HAZEL-8F4K2"
                  autoComplete="off"
                  disabled={loading}
                  className="w-full h-12 rounded-xl bg-slate-950 border border-slate-800 pl-10 pr-4 text-sm text-white uppercase tracking-wider placeholder:text-slate-600 placeholder:tracking-normal focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 disabled:opacity-60"
                />

              </div>

              <p className="text-[11px] text-slate-500 mt-2">
                Invite codes are created by the community owner.
              </p>

              <button
                type="submit"
                disabled={loading}
                className="w-full h-12 mt-5 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:bg-indigo-600/50 disabled:cursor-not-allowed text-white text-sm font-semibold transition-colors flex items-center justify-center gap-2"
              >

                {loading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    Joining...
                  </>
                ) : (
                  <>
                    Join Community
                    <ArrowRight className="w-4 h-4" />
                  </>
                )}

              </button>

            </form>

          )}

          <div className="mt-5 flex items-center justify-between">

            <p className="text-[11px] text-slate-500">
              You can access multiple communities later.
            </p>

            {onLogout && (

              <button
                type="button"
                onClick={onLogout}
                className="text-[11px] text-slate-400 hover:text-white transition-colors"
              >
                Sign out
              </button>

            )}

          </div>

        </div>

      </div>

    </div>
  );
};

interface FeatureProps {
  icon: React.ReactNode;
  title: string;
  description: string;
}

const Feature: React.FC<
  FeatureProps
> = ({
  icon,
  title,
  description,
}) => {
  return (
    <div className="flex gap-3">

      <div className="w-9 h-9 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-indigo-400 shrink-0">
        {icon}
      </div>

      <div>

        <p className="text-sm font-semibold text-white">
          {title}
        </p>

        <p className="text-xs text-slate-400 mt-1 leading-relaxed">
          {description}
        </p>

      </div>

    </div>
  );
};

export default AddGroupPage;